{
  "name": "sigmapay-backend",
  "version": "1.0.0",
  "description": "SigmaPay Backend Server with Express and TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "watch": "tsc -w",
    "test": "npm run build && c8 --reporter=text --reporter=lcov node --test test/*.test.cjs"
  },
  "keywords": [
    "sigmapay",
    "backend",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^20.4.2",
    "c8": "^10.1.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
