NODE_ENV=development
PORT=3001

# Supabase server-side credentials. Never expose SUPABASE_SECRET_KEY to the browser.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true&sslmode=require&connect_timeout=10
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<db-host>:5432/postgres?sslmode=require&connect_timeout=10
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>
SUPABASE_SECRET_KEY=<supabase-secret-key>
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000
REACT_APP_API_URL=http://localhost:3001
