# Local demo defaults. No Supabase account or credentials are required.
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
REACT_APP_API_URL=http://localhost:3001

# Supabase configuration is reserved for future integration. The current app
# uses in-memory repositories and does not persist data to Supabase.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# DATABASE_URL=
# DIRECT_URL=
